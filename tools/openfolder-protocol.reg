Windows Registry Editor Version 5.00

; Registers the "openfolder://" link so the project board can open a folder
; in Explorer with a single click.
;
; Scope   : current user only (no administrator rights required)
; Safety  : opens the path ONLY when it is an existing folder on a local drive
;           (C:\ D:\ ...). Files are never executed and UNC paths (\\server\...)
;           are rejected on purpose.
;
; Install : double-click this file and allow the change.
; Remove  : run openfolder-protocol-uninstall.reg
;
; Link format: openfolder:D:/kyoyu/solution/A020076   (no "//" after the colon)
;
; Note: in the "openfolder://D:/..." form the browser drops the colon of the
;       drive letter and passes "openfolder://D/...". The command below puts
;       the colon back, so links made before this fix keep working.
;
; If the path cannot be opened, a small message box shows what was received,
; which makes a wrong link easy to spot instead of failing silently.

[HKEY_CURRENT_USER\Software\Classes\openfolder]
@="URL:Open Folder Protocol"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\openfolder\shell]

[HKEY_CURRENT_USER\Software\Classes\openfolder\shell\open]

[HKEY_CURRENT_USER\Software\Classes\openfolder\shell\open\command]
@="powershell -NoProfile -NonInteractive -WindowStyle Hidden -Command \"$p=[uri]::UnescapeDataString(('%1' -replace '^openfolder:/*','')) -replace '/','\\'; if($p -match '^[a-zA-Z]\\\\'){$p=$p.Insert(1,':')}; if($p -match '^[a-zA-Z]:\\\\' -and (Test-Path -LiteralPath $p -PathType Container)){explorer.exe $p.TrimEnd('\\')}else{(New-Object -ComObject WScript.Shell).Popup('Cannot open this folder:' + [char]10 + $p,0,'Project Board',48)}\""
